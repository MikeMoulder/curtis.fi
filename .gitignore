# secrets — never commit
.env
.env.*
!.env.example

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/

# contracts/lib/ is deliberately committed rather than kept as submodules, so a
# fresh clone builds with no setup step. foundry.lock is tracked for the same
# reason — it pins the exact dependency revisions.

