# secrets — never commit
.env
.env.*
!.env.example

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/dry-run/

# contracts/lib/ is intentionally not ignored. forge-std is committed as plain
# files; openzeppelin-contracts is a submodule, which `forge build` initialises
# automatically — a plain `git clone` followed by `forge build --root contracts`
# is verified to work from scratch. foundry.lock is tracked so dependency
# revisions stay pinned.

# node
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# logs
*.log
npm-debug.log*
