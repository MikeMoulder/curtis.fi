# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- deployer -----------------------------------------------------------
# Funds contract deployment only. Holds the treasury. Never used by the agent.
DEPLOYER_PRIVATE_KEY=0x

# --- agent --------------------------------------------------------------
# Curtis's own signing key. MUST be a different key from the deployer — the
# deploy script refuses to run if they match, because separating the signing
# authority from the treasury is the entire autonomy claim.
#
# Generate a fresh one for mainnet rather than promoting a testnet key that may
# have appeared in a terminal transcript:
#   cast wallet new
AGENT_PRIVATE_KEY=0x
AGENT_ADDRESS=0x

# --- model -------------------------------------------------------------
# Curtis's decision layer. Server-side only; never NEXT_PUBLIC_.
# Also needs to exist in web/.env.local for the Next.js API route.
ANTHROPIC_API_KEY=

# --- network ------------------------------------------------------------
# 677 = BOT Chain mainnet, 968 = Bohr testnet
NEXT_PUBLIC_CHAIN_ID=677
BOTCHAIN_RPC_URL=https://rpc.botchain.ai
BOHR_RPC_URL=https://rpc.bohr.life

# --- deployed contracts (fill in after deploy) --------------------------
NEXT_PUBLIC_CURTIS_FACTORY_677=
NEXT_PUBLIC_CURTIS_FACTORY_968=

# NOTE: BDEX and token addresses are deliberately NOT configured here.
# They live in contracts/src/BDEXAddresses.sol (and its frontend mirror),
# resolved from the chain id at runtime.
#
# The reason: BDEX's core contracts share the same addresses on both networks,
# but USDT does not — and the mainnet USDT address holds an unrelated
# 18-decimal token ("Weslie"/WES) on testnet. An operator who forgets to swap
# one env var gets silent 10^12 errors with no revert. Selecting by chain id
# makes that mistake unrepresentable.
#
# See docs/botchain-addresses.md.

# --- data sources -------------------------------------------------------
BDEX_V3_SUBGRAPH=https://graph-node.botchain.ai/subgraphs/name/bohrdex/bohrdex-subgraph
BDEX_PRICE_API=https://dex-wallet.botchain.ai
